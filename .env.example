# Ethereum mainnet RPC.
# Default (both unset / commented): built-in rotation over public keyless
# endpoints — mevblocker, publicnode, drpc. Leave as-is unless you have a
# keyed archive endpoint.
#
# RPC_URL pins a SINGLE endpoint and disables rotation (use for a keyed
# archive RPC — Alchemy/Infura/QuickNode/dRPC paid):
#RPC_URL=
#
# RPC_URLS customizes the rotation list (comma-separated):
#RPC_URLS=https://rpc.mevblocker.io,https://ethereum-rpc.publicnode.com,https://eth.drpc.org

# Postgres connection string
DATABASE_URL=postgres://localhost:5432/osero_margin
